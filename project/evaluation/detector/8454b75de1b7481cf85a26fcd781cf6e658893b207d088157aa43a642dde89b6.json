            "highlight_sentence_for_ai": true,
            "special_highlight_type": null
          },
          {
            "generated_prob": 0.99999780950958,
            "sentence": "The study will examine mean waiting time alongside the frequency of long waits, with peak and off-peak periods reported separately [S2].",
