            "special_highlight_type": null
          },
          {
            "generated_prob": 0.9999980055211418,
            "sentence": "We propose comparing a fixed timetable with a holding policy using an anonymized arrival log from one bus route.",
            "perplexity": 0,
            "should_mask": false,
            "masking_reason": null,
            "class_probabilities": {
