            "interpretability_designation": null,
            "interpretability_alpha": null,
            "highlight_sentence_for_ai": true,
            "special_highlight_type": null
          },
          {
            "generated_prob": 0.9999973577156833,
            "sentence": "However, filling every location with a label can turn missing evidence into an apparently definite boundary.",
            "perplexity": 0,
            "should_mask": false,
            "masking_reason": null,
            "class_probabilities": {
              "human": 2.6422843166933604e-06,
