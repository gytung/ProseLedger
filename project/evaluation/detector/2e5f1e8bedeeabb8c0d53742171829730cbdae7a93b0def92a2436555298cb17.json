            "highlight_sentence_for_ai": true,
            "special_highlight_type": null
          },
          {
            "generated_prob": 0.99999671165515,
            "sentence": "In this proposal, cloud cover will remain an unavailable observation.",
            "perplexity": 0,
            "should_mask": false,
