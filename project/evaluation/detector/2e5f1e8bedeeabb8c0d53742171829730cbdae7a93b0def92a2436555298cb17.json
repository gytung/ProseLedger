            "highlight_sentence_for_ai": true,
            "special_highlight_type": null
          },
          {
            "generated_prob": 0.9999971873204869,
            "sentence": "Missing pixels are often inconvenient for a mapping workflow because the output is expected to cover the entire image.",
            "perplexity": 0,
            "should_mask": false,
            "masking_reason": null,
            "class_probabilities": {
              "human": 2.8126795130823882e-06,
