            "highlight_sentence_for_ai": true,
            "special_highlight_type": null
          },
          {
            "generated_prob": 0.9999973577145433,
            "sentence": "The study will utilize two summer visits and a local outline inventory [S1], focusing on how uncertainty is represented rather than assessing specific glacier retreat.",
            "perplexity": 0,
            "should_mask": false,
            "masking_reason": null,
            "class_probabilities": {
