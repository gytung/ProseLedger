            "special_highlight_type": null
          },
          {
            "generated_prob": 0.9999974390100501,
            "sentence": "We propose testing whether allowing a mapping model to abstain on cloud-covered pixels enhances the reliability of boundary comparisons.",
            "perplexity": 0,
            "should_mask": false,
            "masking_reason": null,
            "class_probabilities": {
