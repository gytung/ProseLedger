            "special_highlight_type": null
          },
          {
            "generated_prob": 0.9999997035171488,
            "sentence": "We propose comparing ordinary concise summaries with summaries that retain attribution when accounts conflict.",
            "perplexity": 0,
            "should_mask": false,
