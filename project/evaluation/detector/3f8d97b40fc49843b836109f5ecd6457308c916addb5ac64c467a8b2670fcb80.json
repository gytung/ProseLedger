            "interpretability_alpha": null,
            "highlight_sentence_for_ai": true,
            "special_highlight_type": null
          },
          {
            "generated_prob": 0.9999981838238611,
            "sentence": "We propose to compare raw and drift-corrected conductivity readings against a reference instrument.",
            "perplexity": 0,
            "should_mask": false,
            "masking_reason": null,
            "class_probabilities": {
              "human": 1.8161761388337518e-06,
