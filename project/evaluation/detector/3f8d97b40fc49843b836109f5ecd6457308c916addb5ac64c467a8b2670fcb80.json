            "highlight_sentence_for_ai": true,
            "special_highlight_type": null
          },
          {
            "generated_prob": 0.9999982119807023,
            "sentence": "Correcting such drift should depend on measurement evidence, not on whether an alert seems reasonable.",
            "perplexity": 0,
            "should_mask": false,
            "masking_reason": null,
